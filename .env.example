# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
# Used by local development:
POSTGRES_HOST=localhost
# Used by both Docker and local development:
POSTGRES_PORT=5432
POSTGRES_DB=motus
POSTGRES_USER=motus
POSTGRES_PASSWORD=postgres_password

# ==========================================
# SECURITY & AUTH
# ==========================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your_32_character_or_longer_secret_key_here
JWT_EXPIRATION_HOURS=168

# Allowed browser origins (include both local ports and cloudflare domain)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://pasteldemiolos.xyz

# ==========================================
# METADATA (Optional TMDB Key)
# ==========================================
TMDB_API_KEY=

# ==========================================
# DOCKER PORTS
# ==========================================
# The port mapped to your host when running `docker compose up`
FRONTEND_PORT=3000

# ==========================================
# LOCAL DEV PORTS (npm run dev / mvn)
# ==========================================
# Local backend port
SERVER_PORT=8080
# Local Vite dev server port
VITE_PORT=5173
# Where local Vite proxies /api to
BACKEND_URL=http://localhost:8080
# Allowed hosts for Vite dev server
ALLOWED_HOSTS=pasteldemiolos.xyz,localhost

# ==========================================
# API ROUTING
# ==========================================
# Leave empty so both Docker (Nginx) and Local (Vite proxy) use relative routing
VITE_API_URL=
