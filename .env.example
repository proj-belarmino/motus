# Copy this file to `.env` and fill in real values before running `docker compose up`.
#   cp .env.example .env

# PostgreSQL
POSTGRES_DB=motus
POSTGRES_USER=motus
# Generate a strong password, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing secret (>= 32 characters). Generate with:  openssl rand -hex 32
# If this value is compromised, any JWT can be forged (including admin tokens).
JWT_SECRET=change-me-32+character-random-secret

# (Optional) TMDB v3 key or v4 JWT used for metadata enrichment.
TMDB_API_KEY=

# (Optional) Public URL the React app is served from / calls the API at.
VITE_API_URL=https://pasteldemiolos.xyz
